install.packages("yardstick")
library(tidyverse)
library(caret)
library(ranger)
library(yardstick)
library(ggplot2)
# Load data
spotify_df <- read.csv("dataset/spotify-tracks-dataset.csv")
spotify_df|> dim()
spotify_df|> str()
spotify_df|> head()
removed_feature <- c(track_id, artists, album_name,track_name)
?-c()
?c()
feature_to_remove <- c("track-id", "artists", "album_name", "track_name")
spotify_model <- spotify_df|>
select(-feature_to_remove)
feature_to_remove <- c("track-id", "artists", "album_name", "track_name")
spotify_model <- spotify_df|>
select(-all_of(feature_to_remove))
feature_to_remove <- c("track_id", "artists", "album_name", "track_name")
spotify_model <- spotify_df|>
select(-all_of(feature_to_remove))
spotify_model|>str()
feature_to_remove <- c("X","track_id", "artists", "album_name", "track_name")
spotify_model <- spotify_df|>
select(-all_of(feature_to_remove))
spotify_model|>str()
spotify_model <- spotify_model|>
drop_na()|>
mutate(
explicit = as.factor(explicit),
key = as.factor(key),
mode = as.factor(mode),
time_signature = as.factor(time_signature),
track_genre = as.factor(track_genre)
)
sum(is.na(spotify_model))
table(spotify_model$track_genre)[1:10]
train_index <- createDataPartition(
spotify_model$track_genre,
p = 0.8,
)
train_dat <- spotify_model[train_index, ]
train_index <- createDataPartition(
spotify_model$track_genre,
p = 0.8,
)[[1]]
train_dat <- spotify_model[train_index, ]
test_dat <- spotify_model[-train_index, ]
train_dat|> dim()
test_dat|> dim()
rf_formula <- track_genre ~.
set.seed(5003)
rf_model<-ranger(
formula = rf_formula,
data = train_dat,
num.trees = 300,
mtry = floor(sqrt(ncol(train_dat) - 1)),
min.node.size = 5,
importance = "impurity",
classification = TRUE
)
rf_model
rf_model$num.trees
rf_model$mtry
rf_model$min.node.size
rf_pred <- predict(rf_model, data = test_dat)
test_results <- test_dat|>
mutate(
predicted_genre = rf_pred$predictions
)
head(test_results)
# Accuracy
accuracy_result <- test_results|>
accuracy(
truth = track_genre,
estimate = predicted_genre
)
accuracy_result
# F1 score
f1_result <- test_results|>
f_meas(
truth = track_genre,
estimate = predicted_genre,
estimator = "macro"
)
f1_result
# Confusion Matrix
cm_result <- test_results|>
conf_mat(
truth = track_genre,
estimate = predicted_genre
)
cm_result
# Top 20 genres
top_genres <- test_results|>
count(track_genre, sort = TRUE)|>
slice_head(n = 20)|>
pull(track_genre)
test_top <- test_results|>
filter(
track_genre %in% top_genres,
predicted_genre %in% top_genres
)
cm_top <- test_top|>
conf_mat(
truth = track_genre,
estimate = predicted_genre
)
plot(cm_top, type = "heatmap")+
labs(
title = "Confusion Matrix for Top 20 Genres",
x = "Predicted Genre",
y = "Actual Genre"
) +
theme(
axis.text.x = element_text(angle = 45, hjust = 1)
)
